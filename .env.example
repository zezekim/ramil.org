# Telegram notifications for CV downloads (/cv-infra.pdf)
# Both must be set or notifications are silently skipped.
# Token: create a bot with @BotFather, which returns it on /newbot
TELEGRAM_BOT_TOKEN=
# Chat ID: message your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[0].message.chat.id
TELEGRAM_CHAT_ID=

# Optional: override the Telegram API endpoint (used for local testing only)
# TELEGRAM_API_BASE=http://localhost:3222
